<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in for the game in the session tests: KingdomCome.exe that loads a WHGame.dll, writes a kcd.log, and exits when told. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KingdomCome</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
